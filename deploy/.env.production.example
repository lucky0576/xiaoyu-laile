# ==========================================================================
# 小鱼来了 —— 生产环境变量
# 用法：复制为 deploy/.env 并修改带 ★ 的项目
# ==========================================================================

# ★ 你的域名（必须已解析到本服务器公网 IP）
DOMAIN=xiaoyu.example.com

# ★ 申请 HTTPS 证书用的邮箱（Let's Encrypt 到期提醒）
ACME_EMAIL=you@example.com

# ★ 会话签名密钥。随机生成一个，别用默认值：
#   Linux:  openssl rand -hex 48
#   Windows:  -join ((1..96) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
SESSION_SECRET=请替换为随机字符串

# ---------- 应用信息 ----------
APP_NAME=小鱼来了
APP_SLOGAN=让每一条好项目，都被对的人看见
PUBLIC_BASE_URL=https://xiaoyu.example.com
NO_SEED=0

# ---------- AI（可选，不填走内置规则引擎）----------
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=

# ---------- 微信（可选）----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_TOKEN=
WECHAT_DEMO_MODE=true

# ---------- 邮件（可选）----------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- 其他 ----------
SMS_PROVIDER=demo
SMS_DEMO_RETURN_CODE=true
PAYMENT_PROVIDER=offline
MAX_UPLOAD_BYTES=536870912
