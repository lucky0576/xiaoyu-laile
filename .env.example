# ==========================================================================
# 小鱼来了 — 环境变量示例
# 复制为 .env 后按需修改。全部留空也能跑（走内置规则引擎 + 演示模式）。
# ==========================================================================

# ---------- 基本 ----------
APP_NAME=小鱼来了
APP_SLOGAN=让每一条好项目，都被对的人看见
HOST=0.0.0.0
PORT=8787

# 对外可访问的根地址。部署到公网/内网穿透后填这里，
# 分享链接与二维码会用它生成（不填则按访问者浏览器地址生成）。
# PUBLIC_BASE_URL=https://xiaoyu.example.com

# 会话签名密钥。不填会自动生成并写入 data/.secret
# SESSION_SECRET=

# 数据目录（默认 ./data）
# DATA_DIR=data

# 上传大小上限（字节），默认 512MB，用于支持视频上传
# MAX_UPLOAD_BYTES=536870912

# ---------- AI（任何 OpenAI 兼容接口） ----------
# 不配置 AI_API_KEY 时使用内置本地规则引擎（正则 + 词表 + 评分模型），平台功能完整可用。
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AI_TIMEOUT_MS=60000

# 其他可用的 OpenAI 兼容服务示例：
#   通义千问   AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   AI_MODEL=qwen-plus
#   Moonshot  AI_BASE_URL=https://api.moonshot.cn/v1                           AI_MODEL=moonshot-v1-8k
#   OpenAI    AI_BASE_URL=https://api.openai.com/v1                            AI_MODEL=gpt-4o-mini

# ---------- 微信 ----------
# 公众号（微信内网页授权登录 + JS-SDK 分享到好友/朋友圈）
# WECHAT_APP_ID=wxxxxxxxxxxxxxxxxx
# WECHAT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 开放平台网站应用（PC 端扫码登录）
# WECHAT_OPEN_APP_ID=wxxxxxxxxxxxxxxxxx
# WECHAT_OPEN_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 公众号后台「服务器配置」的 Token（用于 /api/wechat/callback 验签）
# WECHAT_TOKEN=xxxxxxxx
# 未配置微信时是否允许「一键演示登录」
WECHAT_DEMO_MODE=true

# ---------- 邮件（注册验证码 / 通知） ----------
# 不配置时验证码直接返回给前端并写入 data/outbox.log（演示模式）
# SMTP_HOST=smtp.exmail.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@example.com
# SMTP_PASS=xxxxxxxx
# SMTP_FROM=小鱼来了 <no-reply@example.com>

# ---------- 短信 ----------
# demo = 不真正发短信，验证码写控制台并随响应返回
SMS_PROVIDER=demo
SMS_DEMO_RETURN_CODE=true

# ---------- 支付 ----------
# offline = 演示支付（不扣款）；接真实支付时替换 payments 服务
PAYMENT_PROVIDER=offline
PLATFORM_FEE_RATE=0.03

# ---------- 线上会议 ----------
# builtin = 内置 WebRTC 房间（HTTP 信令 + SSE），无需额外服务
MEETING_PROVIDER=builtin
# 若要跳转到第三方会议（腾讯会议/飞书等），配置模板，{id} 会被替换
# MEETING_URL_TEMPLATE=https://meeting.tencent.com/dm/{id}

# ---------- 导入演示数据 ----------
# 设为 1 可跳过首次启动的演示数据写入
# NO_SEED=1
